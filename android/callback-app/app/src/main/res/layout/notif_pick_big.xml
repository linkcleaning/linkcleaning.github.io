<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/pTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="#0F172A" />
    <TextView android:id="@+id/pInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#64748B" android:layout_marginBottom="6dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
        <TextView android:id="@+id/p1" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/pick_btn" android:gravity="center" android:textColor="#075985" android:textSize="15sp" android:textStyle="bold" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/p2" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/pick_btn" android:gravity="center" android:textColor="#075985" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
        <TextView android:id="@+id/p3" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/pick_btn" android:gravity="center" android:textColor="#075985" android:textSize="15sp" android:textStyle="bold" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/p4" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/pick_btn" android:gravity="center" android:textColor="#075985" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/pDef" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="2" android:background="@drawable/pick_btn_main" android:gravity="center" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/pSkip" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:text="안 보내기" android:textColor="#64748B" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
