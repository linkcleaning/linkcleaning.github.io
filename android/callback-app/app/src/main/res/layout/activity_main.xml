<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="링크클린 자동 콜백"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Hint"
            android:layout_marginBottom="14dp"
            android:text="손님 전화(수신·부재중)가 끝나면 홍보 사진문자를 자동으로 보냅니다" />

        <!-- 권한 경고 -->
        <LinearLayout
            android:id="@+id/warnBox"
            style="@style/Card"
            android:background="@drawable/warn_bg"
            android:visibility="gone">
            <TextView
                android:id="@+id/warnText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/warn_text"
                android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="지금 설정하기" />
        </LinearLayout>

        <!-- ON/OFF -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginBottom="12dp"
            android:text="자동 콜백 OFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <!-- 오늘 현황 -->
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="오늘 자동 발송" />
                <TextView
                    android:id="@+id/todayCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0건"
                    android:textColor="@color/brand"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                style="@style/Hint"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="최근 기록" />
            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:padding="6dp"
                android:text="기록 지우기"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 문구 -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="보낼 문구" />
            <EditText
                android:id="@+id/editSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="제목 (비워도 됨)"
                android:inputType="text"
                android:textSize="15sp" />
            <EditText
                android:id="@+id/editMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:textSize="15sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="문구 저장" />
        </LinearLayout>

        <!-- 사진 -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="홍보 사진" />
            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#EEF1F5"
                android:contentDescription="홍보 사진"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/imgInfo"
                style="@style/Hint"
                android:layout_marginTop="6dp"
                android:text="사진 없음 – 글자만 보냅니다" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="2"
                    android:text="사진 교체" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemoveImage"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="사진 빼기" />
            </LinearLayout>
        </LinearLayout>

        <!-- 발송 조건 -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="발송 조건" />
            <CheckBox android:id="@+id/chkIncoming" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="받은 전화 끝나면 발송" />
            <CheckBox android:id="@+id/chkMissed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="부재중 / 거절한 전화에도 발송" />
            <CheckBox android:id="@+id/chkMobile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="휴대폰 번호(010 등)에만 발송" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="같은 번호 재발송 금지 (시간)" android:textColor="@color/text_main" />
                <EditText android:id="@+id/editCooldown" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="center" android:inputType="number" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="하루 최대 발송 건수" android:textColor="@color/text_main" />
                <EditText android:id="@+id/editDailyLimit" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="center" android:inputType="number" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="조건 저장" />
        </LinearLayout>

        <!-- 제외 번호 -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="문자 안 보낼 번호 (본인·가족·거래처)" />
            <TextView style="@style/Hint" android:text="한 줄에 하나씩. 번호 뒤에 이름을 적어도 됩니다.\n예) 010-1234-5678 아내" />
            <EditText
                android:id="@+id/editBlacklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:textSize="15sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveBlacklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="제외 번호 저장" />
        </LinearLayout>

        <!-- 테스트 -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="테스트 발송" />
            <TextView style="@style/Hint" android:text="내 다른 폰 번호로 실제 문자가 어떻게 가는지 확인 (쿨타임 무시)" />
            <EditText
                android:id="@+id/editTestNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="받을 번호 010-0000-0000"
                android:inputType="phone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="지금 테스트 문자 보내기" />
        </LinearLayout>

        <!-- 설정 바로가기 -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="꺼지지 않게 하기" />
            <TextView
                android:id="@+id/batteryInfo"
                style="@style/Hint"
                android:layout_marginBottom="6dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBattery"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="배터리 최적화 예외 등록" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="앱 정보 열기 (권한·제한된 설정)" />
        </LinearLayout>

        <TextView
            android:id="@+id/versionText"
            style="@style/Hint"
            android:gravity="center"
            android:paddingBottom="24dp" />
    </LinearLayout>
</ScrollView>
